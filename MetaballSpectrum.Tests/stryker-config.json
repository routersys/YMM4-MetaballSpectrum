{
  "stryker-config": {
    "project": "MetaballSpectrum.csproj",
    "test-runner": "mtp",
    "coverage-analysis": "off",
    "concurrency": 4,
    "additional-timeout": 30000,
    "mutate": [
      "**/*.cs",
      "!**/YMM4-GitHubUpdateNotifier/**",
      "!**/YMM4-Telemetry/**",
      "!**/MetaballSpectrumTelemetry.cs",
      "!**/MetaballSpectrumUpdateNotifier.cs"
    ],
    "reporters": [
      "progress",
      "cleartext",
      "html"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 60
    }
  }
}
